<?xml version="1.0" encoding="UTF-8"?>
<!--
  电商运营与智能问数中台系统 (E-Commerce Ops & AI Copilot Platform)
  版本选型依据（每个版本均已在阿里云 Maven 镜像与本地仓库验证真实存在）：
    Spring Boot        3.5.16  3.x 最新稳定 LTS 分支
    Spring AI          1.1.8   与 Spring Boot 3.x 深度配套
    JSqlParser         5.4     SQL AST 语法树解析与安全沙箱防护
    PostgreSQL JDBC    42.7.13 最新驱动（由 Spring Boot 父 POM 管理）
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.ecommerce.platform</groupId>
  <artifactId>ecommerce-admin-agent</artifactId>
  <version>1.0.0</version>
  <name>ecommerce-admin-agent</name>
  <description>电商运营与智能问数中台系统 (E-Commerce Ops &amp; AI Copilot Platform)</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-ai.version>1.1.8</spring-ai.version>
    <jsqlparser.version>5.4</jsqlparser.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Web 接入层：提供中台 RESTful 接口与静态页面托管 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- JDBC + Hikari 连接池：支撑商品/订单 CRUD 与只读沙箱执行 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!-- 参数校验：控制器入参校验 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- 大模型集成：OpenAI 协议驱动 -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-model-openai</artifactId>
    </dependency>

    <!-- SQL AST 解析与白名单校验 -->
    <dependency>
      <groupId>com.github.jsqlparser</groupId>
      <artifactId>jsqlparser</artifactId>
      <version>${jsqlparser.version}</version>
    </dependency>

    <!-- PostgreSQL 数据库驱动 -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- 业务口径 metrics.yml 解析 -->
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>

    <!-- 单元与集成测试 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
